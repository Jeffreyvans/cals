# --- online payments (Paynow Zimbabwe) ----------------------------------
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_MODE=test                 # test or live
PAYNOW_RETURN_URL=
PAYNOW_RESULT_URL=

# --- fiscalisation (ZIMRA FDMS) -----------------------------------------
EDUSPHERE_FISCALISATION_ENABLED=true
EDUSPHERE_FISCALISATION_GATEWAY=mock
EDUSPHERE_ZIMRA_FDMS_URL=
EDUSPHERE_ZIMRA_DEVICE_ID=
EDUSPHERE_ZIMRA_DEVICE_SERIAL=
EDUSPHERE_ZIMRA_API_KEY=

# --- encrypted finance backup -------------------------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EDUSPHERE_FINANCE_BACKUP_KEY=
