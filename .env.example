# Copy to .env next to manage.py for local development, or type the same
# variables into the Render dashboard. Real environment variables always win
# over values in .env. Everything is optional locally: with no .env at all the
# app runs on SQLite with DEBUG on and prints email to the console.
#
# Placeholder values below are deliberately obvious. Replace them and never
# commit the real file.

# --- core ---------------------------------------------------------------
DEBUG=true                       # false in production (Render sets this)
SECRET_KEY=replace-with-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Render supplies this automatically; leave blank everywhere else.
RENDER_EXTERNAL_HOSTNAME=

# --- database -----------------------------------------------------------
# PostgreSQL URL, e.g. from Render or Supabase's session pooler:
# postgresql://postgres.project:password@host:5432/postgres
DATABASE_URL=
DB_SSL_MODE=require              # require for hosted PostgreSQL; blank locally
EDUSPHERE_DB_PATH=db.sqlite3     # SQLite fallback, relative to the project root

# --- main platform administrator (read by ensure_platform_admin) ---------
# Never commit real values. The password is validated and stored hashed only.
PLATFORM_ADMIN_USERNAME=platform-admin
PLATFORM_ADMIN_EMAIL=platform-admin@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password
PLATFORM_ADMIN_RESET_PASSWORD=false   # true for ONE deploy to replace the password
PLATFORM_ADMIN_FORCE_CHANGE=true      # force a new password at first sign-in

# --- static and uploaded files ------------------------------------------
STORAGE_BACKEND=local            # local, s3, r2, b2 or supabase
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=             # e.g. https://<project>.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=auto          # auto for R2, a region for B2/Supabase
AWS_S3_CUSTOM_DOMAIN=            # optional public CDN domain
AWS_LOCATION=                    # optional key prefix, e.g. edusphere

# --- email --------------------------------------------------------------
# All mail goes through an HTTPS API via django-anymail. Render blocks outbound
# SMTP on ports 25, 465 and 587, so there are no SMTP settings here. Mailjet is
# the production default; Brevo and Resend remain selectable. With no keys at
# all the console backend is used (local development and tests). Links in
# emails are built from SITE_URL, never from the request host.
EMAIL_PROVIDER=mailjet           # mailjet, brevo, resend or console
MAILJET_API_KEY=                 # Mailjet account settings -> API keys
MAILJET_SECRET_KEY=              # Mailjet account settings -> API keys
BREVO_API_KEY=                   # only when EMAIL_PROVIDER=brevo
RESEND_API_KEY=                  # legacy/backwards-compatible provider
MAILJET_API_URL=https://api.mailjet.com/v3.1/
BREVO_API_URL=https://api.brevo.com/v3/
RESEND_API_URL=https://api.resend.com/
DEFAULT_FROM_EMAIL=EduSphere <no-reply@your-verified-domain.example>
SERVER_EMAIL=EduSphere <no-reply@your-verified-domain.example>
DEFAULT_REPLY_TO_EMAIL=support@your-verified-domain.example
EMAIL_FROM_DOMAIN=your-verified-domain.example
SITE_URL=https://your-app.onrender.com   # https, no trailing slash
MAILJET_WEBHOOK_SECRET=          # user:pass from the Mailjet webhook URL
RESEND_WEBHOOK_SECRET=           # whsec_... from the Resend webhook settings
EMAIL_TIMEOUT=10                 # seconds; a slow provider must not freeze a page
# Optional: only on a deployment that runs a Celery worker.
EMAIL_ASYNC=false
# Reliability and abuse limits (all optional; sensible defaults shown).
EMAIL_MAX_RETRIES=5
EMAIL_RETRY_BACKOFF_SECONDS=60
EMAIL_VERIFY_LIMIT=5
EMAIL_RESET_LIMIT=5
EMAIL_IP_LIMIT=20
EMAIL_BULK_LIMIT=500
EMAIL_RATE_WINDOW_SECONDS=3600
PASSWORD_RESET_TIMEOUT=3600

# --- HTTPS (production defaults are safe; override only if needed) -------
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
# Legacy local opt-in when DEBUG is on:
EDUSPHERE_SSL=false
EDUSPHERE_HSTS_SECONDS=0

# --- school identity ----------------------------------------------------
EDUSPHERE_INSTITUTION_NAME=Lindenet Institute of Technology
EDUSPHERE_CURRENCY=$
EDUSPHERE_TIME_ZONE=Africa/Harare
EDUSPHERE_MEDIA_PATH=media

# --- legacy aliases (still supported; the generic names above win) -------
