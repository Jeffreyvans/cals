# Copy this file to .env next to manage.py and edit to taste.
# Everything is optional while running with DEBUG on; production
# (EDUSPHERE_DEBUG=0) requires EDUSPHERE_SECRET_KEY and EDUSPHERE_ALLOWED_HOSTS.
# Real environment variables always win over values in .env.

# --- required when DEBUG is off -------------------------------------------
EDUSPHERE_SECRET_KEY=            # long random string; python -c "import secrets; print(secrets.token_urlsafe(50))"
EDUSPHERE_ALLOWED_HOSTS=         # comma-separated hostnames, e.g. fees.school.example,10.0.0.5

# --- general ---------------------------------------------------------------
EDUSPHERE_DEBUG=1                # 1/true/yes or 0/false/no
EDUSPHERE_CSRF_TRUSTED_ORIGINS=  # e.g. https://fees.school.example,http://10.0.0.5:8000

# --- database (SQLite by default) -----------------------------------------
EDUSPHERE_DB_PATH=db.sqlite3     # relative to the project root, or an absolute path
EDUSPHERE_MEDIA_PATH=media       # uploaded files; relative to the project root or absolute

# --- school identity -------------------------------------------------------
EDUSPHERE_INSTITUTION_NAME=Lindenet Institute of Technology
EDUSPHERE_CURRENCY=$
EDUSPHERE_TIME_ZONE=Africa/Harare

# --- email invitations (Resend) -------------------------------------------
EDUSPHERE_RESEND_API_KEY=        # from the Resend dashboard; blank uses console/SMTP
EDUSPHERE_RESEND_FROM=           # e.g. "Mavambo College <accounts@mavambo.example>"
EDUSPHERE_RESEND_API_URL=https://api.resend.com/emails

# --- HTTPS (opt-in; set after putting the site behind TLS) ----------------
EDUSPHERE_SSL=0
EDUSPHERE_HSTS_SECONDS=0         # e.g. 31536000 once HTTPS is stable

# --- online payments (Paynow Zimbabwe) ------------------------------------
PAYNOW_INTEGRATION_ID=           # from the Paynow merchant dashboard
PAYNOW_INTEGRATION_KEY=          # keep this secret
PAYNOW_MODE=test                 # test or live
PAYNOW_RETURN_URL=               # where the payer returns after paying
PAYNOW_RESULT_URL=               # public URL Paynow posts the result to
